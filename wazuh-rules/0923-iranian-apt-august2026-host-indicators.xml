<!--
  Wazuh Rules for Iranian APT Detection - August 2026 Host Indicators
  Version: 1.0
  Last Updated: 2026-08-09

  Host-side detections complementing the Suricata network signatures
  (SID 2000562-2000567) for the July 2026 Operation Olalampo update
  (Group-IB, "MuddyWater: ClickFix to Telegram & PatchAgent Backdoor").

  MuddyWater delivers via a ClickFix lure (attacker commands pasted into
  the Windows Run dialog). The three-stage PatchAgent loader runs a
  regsvr32-executed COM dropper, decrypts an AES-256-CBC "PTCH" v2
  container, and injects an HTTP shellcode backdoor into a hollowed
  notepad.exe. Supporting families (CHAR, GhostFetch, HTTP_VIP) drop
  named executables and install persistence.

  Rule ID Range: 101530-101533 (next available after 0921's 101529)

  References:
    - Group-IB: "MuddyWater: ClickFix to Telegram & PatchAgent Backdoor" (July 2026)
    - Group-IB: Operation Olalampo (Feb 2026)
-->

<group name="iranian_apt,august2026_host,muddywater,olalampo,">

  <!-- ========== OLALAMPO JULY 2026 UPDATE (101530-101533) ========== -->

  <!-- CHAR dropper: novaservice.exe written to / executed from a user-writable
       Public\Downloads path (Sysmon Event 1). MuddyWater CHAR stages its
       Rust backdoor as novaservice.exe; no clean system runs a "novaservice"
       from Public\Downloads. (T1036.005, T1105) -->
  <rule id="101536" level="8">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\Users\\Public\\Downloads\\novaservice\.exe$</field>
    <description>Iranian APT: MuddyWater Olalampo - CHAR novaservice.exe execution from Public\Downloads</description>
    <mitre>
      <id>T1036.005</id>
      <id>T1105</id>
    </mitre>
    <group>attack,execution,muddywater,pci_dss_10.6.1,</group>
  </rule>

  <!-- GhostFetch persistence: burn.exe under %LOCALAPPDATA%\microsoft\windows\burnutill\
       (Sysmon Event 1). The burnutill directory + burn.exe combination is the
       GhostFetch second-stage persistence path. (T1547.001, T1055) -->
  <rule id="101537" level="8">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\microsoft\\windows\\burnutill\\burn\.exe$</field>
    <description>Iranian APT: MuddyWater Olalampo - GhostFetch burnutill\burn.exe persistence execution</description>
    <mitre>
      <id>T1547.001</id>
      <id>T1055</id>
    </mitre>
    <group>attack,persistence,muddywater,pci_dss_10.6.1,</group>
  </rule>

  <!-- Olalampo admin persistence: creation of a Windows service named
       "MicrosoftVersionUpdater" (Sysmon Event 13 registry / Security 7045).
       This masquerading service name is used for admin-level installations
       of the Olalampo implants. (T1543.003, T1036.004) -->
  <rule id="101538" level="8">
    <if_group>sysmon_event_13</if_group>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)\\Services\\MicrosoftVersionUpdater\\</field>
    <description>Iranian APT: MuddyWater Olalampo - MicrosoftVersionUpdater masquerading service persistence</description>
    <mitre>
      <id>T1543.003</id>
      <id>T1036.004</id>
    </mitre>
    <group>attack,persistence,muddywater,pci_dss_10.6.1,</group>
  </rule>

  <!-- FMAPP DLL sideload: FMAPP.exe loading FMAPP.dll (reverse SOCKS5 proxy
       injector) from a non-Program Files path (Sysmon Event 7 ImageLoad).
       The genuine FMAPP (Fingerprint/audio helper) ships in vendor Program
       Files paths; a user-writable copy is the Olalampo reverse-proxy loader.
       (T1574.002, T1090) -->
  <rule id="101539" level="11">
    <if_group>sysmon_event7</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\FMAPP\.exe$</field>
    <field name="win.eventdata.imageLoaded" type="pcre2">(?i)^(?!.*\\Program Files).*\\FMAPP\.dll$</field>
    <description>Iranian APT: MuddyWater Olalampo - FMAPP.dll reverse SOCKS5 sideload from non-Program Files path</description>
    <mitre>
      <id>T1574.002</id>
      <id>T1090</id>
    </mitre>
    <group>attack,command_and_control,muddywater,pci_dss_10.6.1,</group>
  </rule>

</group>
