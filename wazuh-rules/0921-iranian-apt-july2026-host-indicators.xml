<!--
  Wazuh Rules for Iranian APT Detection - July 2026 Host Indicators
  Version: 1.1
  Last Updated: 2026-07-13

  Host-side detections complementing the Suricata network signatures
  (SID 2000553-2000561) for the Cavern Manticore modular C2 framework
  (Check Point Research, July 2026). Cavern Manticore is an Iran
  MOIS-linked actor (OilRig/Lyceum nexus) targeting Israeli government
  and IT-sector organizations.

  The Cavern (ex-Cav3rn) agent deploys via DLL sideloading: a legitimate
  WinDirStat.exe copied to C:\ProgramData\WinDir\ loads a trojanized
  uxtheme.dll (83 exports, 82 empty stubs, real entry at ordinal #20
  EnableThemeDialogTexture). Config lives in config.txt (JSON keys
  i/xd/int) in the working directory.

  Also contains host indicators for the Seedworm/MuddyWater nine-country
  DLL sideloading campaign (WatchGuard, 2026-07-01): signed Fortemedia
  fmapp.exe -> fmapp.dll and SentinelOne sentinelmemoryscanner.exe ->
  sentinelagentcore.dll sideloads embedding ChromElevator. Network-side
  companions: Suricata SID 2000562-2000563 (sendit.sh exfil staging).

  Rule ID Range: 101528-101531 (next available after 0920's 101527)

  References:
  - Check Point Research "Cavern Manticore: Exposing Iran-Linked Modular
    C2 Framework" (July 2026)
  - WatchGuard threat report on Seedworm Q1 2026 espionage campaign
    (2026-07-01); Huntress corroboration
-->

<group name="iranian_apt,july2026_host,cavern_manticore,">

  <!-- ========== CAVERN MANTICORE DLL SIDELOAD CHAIN (101528-101529) ========== -->

  <!-- WinDirStat.exe loading uxtheme.dll from a non-System32 path
       (Sysmon Event 7 ImageLoad). Legitimate uxtheme.dll loads only from
       %SystemRoot%\System32 / SysWOW64; a copy loaded from ProgramData or
       any user-writable directory alongside WinDirStat is the Cavern
       sideload. (T1574.002) -->
  <rule id="101528" level="14">
    <if_group>sysmon_event7</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\windirstat\.exe$</field>
    <field name="win.eventdata.imageLoaded" type="pcre2">(?i)^(?!.*\\Windows\\(System32|SysWOW64)\\).*\\uxtheme\.dll$</field>
    <description>Iranian APT: Cavern Manticore - WinDirStat.exe sideloading uxtheme.dll from non-system path (Cavern agent entry)</description>
    <mitre>
      <id>T1574.002</id>
      <id>T1036.005</id>
    </mitre>
    <group>attack,defense_evasion,cavern_manticore,pci_dss_10.6.1,</group>
  </rule>

  <!-- Any process executing from C:\ProgramData\WinDir\ (Sysmon Event 1).
       This directory is the Cavern deployment path and does not exist on
       clean systems — ProgramData\WinDir masquerades as a Windows path.
       (T1036.005) -->
  <rule id="101529" level="13">
    <if_group>sysmon_event_1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\ProgramData\\WinDir\\</field>
    <description>Iranian APT: Cavern Manticore - process execution from C:\ProgramData\WinDir\ masquerade directory</description>
    <mitre>
      <id>T1036.005</id>
      <id>T1574.002</id>
    </mitre>
    <group>attack,defense_evasion,cavern_manticore,pci_dss_10.6.1,</group>
  </rule>

  <!-- ========== SEEDWORM NINE-COUNTRY SIDELOAD CHAIN (101530-101531) ========== -->

  <!-- Seedworm/MuddyWater nine-country DLL sideloading campaign (WatchGuard
       2026-07-01, Huntress corroboration). Signed SentinelOne memory
       scanner binary sideloads the malicious sentinelagentcore.dll
       (embeds ChromElevator browser credential theft). The DLL name is
       attacker-invented — the legitimate scanner never loads it, so any
       path matches. (T1574.002, T1555.003) -->
  <rule id="101530" level="14">
    <if_group>sysmon_event7</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\sentinelmemoryscanner\.exe$</field>
    <field name="win.eventdata.imageLoaded" type="pcre2">(?i)\\sentinelagentcore\.dll$</field>
    <description>Iranian APT: Seedworm - sentinelmemoryscanner.exe sideloading sentinelagentcore.dll (ChromElevator credential theft chain)</description>
    <mitre>
      <id>T1574.002</id>
      <id>T1555.003</id>
    </mitre>
    <group>attack,defense_evasion,credential_access,seedworm,pci_dss_10.6.1,</group>
  </rule>

  <!-- Same campaign: signed Fortemedia audio binary fmapp.exe sideloading
       fmapp.dll from outside the legitimate driver install paths
       (Program Files / Windows). The campaign drops both files into
       user-writable directories; the legitimate pairing only ever loads
       from the driver package location. fmapp.dll beacons to
       157.20.182.49 (Suricata SID 2000156/2000316/2000326/2000515).
       (T1574.002) -->
  <rule id="101531" level="14">
    <if_group>sysmon_event7</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\fmapp\.exe$</field>
    <field name="win.eventdata.imageLoaded" type="pcre2">(?i)^(?!.*\\(Program Files( \(x86\))?|Windows)\\).*\\fmapp\.dll$</field>
    <description>Iranian APT: Seedworm - fmapp.exe sideloading fmapp.dll from non-standard path (ChromElevator credential theft chain)</description>
    <mitre>
      <id>T1574.002</id>
      <id>T1555.003</id>
    </mitre>
    <group>attack,defense_evasion,credential_access,seedworm,pci_dss_10.6.1,</group>
  </rule>

</group>
