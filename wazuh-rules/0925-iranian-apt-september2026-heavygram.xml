<!--
  Wazuh rules for HEAVYGRAM / CHOSEN BRICK (September 2026).
  Iranian MOIS Windows surveillance implant exposed in the joint NCSC/FBI/AIVD
  advisory of 2026-09-15 (NCSC name CHOSEN BRICK, FBI name HEAVYGRAM). Used
  against dissidents, activists and journalists. Because the network C2 rides
  encrypted Telegram Bot API traffic and the advisory warns that filenames and
  registry values vary between victims, host-side telemetry carries the
  high-confidence detection: Run-key persistence, the distinctive dropped
  paths (including the inserted-space system-directory lookalike), and the
  execution mutexes.
  Rule IDs 101545-101550. References:
    https://www.ncsc.gov.uk/news/iranian-cyber-targeting-of-dissidents-activists-and-journalists
-->
<group name="iranian_apt,heavygram,chosen_brick,mois,september2026,">

  <rule id="101545" level="12">
    <if_sid>61603,61604,61605</if_sid>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)\\CurrentVersion\\Run\\(SMQDService|winappx)$</field>
    <description>HEAVYGRAM/CHOSEN BRICK Run-key persistence value (SMQDService/winappx) created - Iranian MOIS spyware.</description>
    <mitre>
      <id>T1547.001</id>
    </mitre>
  </rule>

  <rule id="101546" level="13">
    <if_sid>592</if_sid>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)(\\ProgramData\\SMQDServicePackages\\|\\MicrosoftDistribution\\sysmain\\winappx\.exe|\\sm[dq]{2}service\.exe)</field>
    <description>HEAVYGRAM/CHOSEN BRICK implant binary dropped under a known ProgramData/MicrosoftDistribution path - Iranian MOIS spyware.</description>
    <mitre>
      <id>T1105</id>
      <id>T1036.005</id>
    </mitre>
  </rule>

  <rule id="101547" level="13">
    <if_sid>592,60103,60104</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\Windows \\SysWOW64\\</field>
    <description>HEAVYGRAM/CHOSEN BRICK inserted-space system-directory lookalike (C:\Windows \SysWOW64) - masquerading TTP, Iranian MOIS spyware.</description>
    <mitre>
      <id>T1036.005</id>
    </mitre>
  </rule>

  <rule id="101548" level="12">
    <if_sid>60103,60104</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\(MsCache|chromedriver)\.exe$</field>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)\\(ProgramData|Users\\All Users|AppData)\\</field>
    <description>HEAVYGRAM/CHOSEN BRICK secondary component (MsCache.exe/chromedriver.exe) executed from a user-writable path - Iranian MOIS spyware.</description>
    <mitre>
      <id>T1105</id>
      <id>T1059</id>
    </mitre>
  </rule>

  <rule id="101549" level="10">
    <if_sid>61600,61613</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)(ytyjyujyu|noi672pp434awkc12f)</field>
    <description>HEAVYGRAM/CHOSEN BRICK execution mutex (ytyjyujyu / noi672pp434awkc12f) observed - Iranian MOIS spyware single-instance marker.</description>
    <mitre>
      <id>T1480</id>
    </mitre>
  </rule>

  <rule id="101550" level="14" frequency="2" timeframe="600">
    <if_matched_sid>101545</if_matched_sid>
    <if_sid>101546,101547,101548</if_sid>
    <same_source_ip />
    <description>HEAVYGRAM/CHOSEN BRICK multi-stage host activity (persistence + implant/masquerade) on one host - high-confidence Iranian MOIS spyware infection.</description>
    <mitre>
      <id>T1547.001</id>
      <id>T1105</id>
    </mitre>
  </rule>

</group>
